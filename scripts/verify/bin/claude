#!/usr/bin/env node
// Verification fake of `claude`. No network, no model. Logs every start to $FAKE_LOG; behaviour switches via $FAKE_CTL (json) and trigger words.
import fs from 'node:fs'; import readline from 'node:readline'; import crypto from 'node:crypto'; import path from 'node:path'; import os from 'node:os';
const argv = process.argv.slice(2), log = o => { try { fs.appendFileSync(process.env.FAKE_LOG, JSON.stringify({ t: Date.now(), ...o }) + '\n'); } catch {} };
const ctl = () => { try { return JSON.parse(fs.readFileSync(process.env.FAKE_CTL, 'utf8')); } catch { return {}; } };
const send = m => process.stdout.write(JSON.stringify(m) + '\n');
const envLog = { CLAUDE_CODE_ARTIFACT: process.env.CLAUDE_CODE_ARTIFACT, CLAUDE_CODE_MCP_STARTUP_WAIT_MS: process.env.CLAUDE_CODE_MCP_STARTUP_WAIT_MS };
// `claude update` (Settings/chat "새 버전" notice): installs the registry's newest version, i.e. what a real update would leave behind.
const versionFile = process.env.FAKE_CTL + '.version', installed = () => { try { return fs.readFileSync(versionFile, 'utf8').trim(); } catch { return '2.1.322'; } };
if (argv[0] === '--version') { console.log(installed() + ' (fake)'); process.exit(0); }
if (argv[0] === 'update' || argv[0] === 'upgrade') { log({ update: true, from: installed() }); const next = ctl().updateTo ?? '2.1.999'; if (ctl().updateFails) { console.error('Error: update failed (fake)'); process.exit(1); } fs.writeFileSync(versionFile, next); console.log('Successfully updated from ' + installed().replace(/^/, '') + ' to version ' + next); process.exit(0); }
if (argv[0] === 'auth') { console.log(JSON.stringify({ loggedIn: true, authMethod: 'fake' })); process.exit(0); }
const stream = argv.includes('--input-format') && argv.includes('stream-json');
if (!stream) {
  // `claude -p --output-format json`: the feedback AI draft (prompt on stdin).
  let input = ''; process.stdin.on('data', c => input += c);
  process.stdin.on('end', async () => {
    const mode = ctl().fb ?? 'ok'; log({ kind: 'oneshot', argv, cwd: process.cwd(), env: envLog, stdin: input.slice(0, 4000), mode });
    // /btw (chat-btw.js passes --disable-slash-commands): a short answer with the usage the CLI reports.
    // The feedback AI draft passes the same isolation flags but also --allowedTools Read: only the btw run (no tools at all) gets this answer.
    if (argv.includes('--disable-slash-commands') && !argv.includes('--allowedTools')) { console.log(JSON.stringify({ type: 'result', is_error: false, result: '곁다리 답입니다. 비동기 함수는 Promise를 돌려줍니다.', total_cost_usd: 0.0174, usage: { input_tokens: 812, output_tokens: 96, cache_creation_input_tokens: 0, cache_read_input_tokens: 14200 } })); process.exit(0); }
    if (mode === 'fail') { console.error('boom'); process.exit(1); }
    if (mode === 'badjson') { console.log('this is not json'); process.exit(0); }
    if (mode === 'empty') { console.log(JSON.stringify({ type: 'result', is_error: false, result: '' })); process.exit(0); }
    if (mode === 'iserror') { console.log(JSON.stringify({ type: 'result', is_error: true, result: 'quota' })); process.exit(0); }
    if (mode === 'slow') await new Promise(r => setTimeout(r, 4000));
    console.log(JSON.stringify({ type: 'result', is_error: false, result: JSON.stringify({ title: '[버그] 가짜 제목', types: ['bug', 'perf'], body: '## 문제\n가짜 본문 ' + 'x'.repeat(40) + '\n\n## 기대 동작\n되어야 함\n\n## 개선 제안\n고쳐 주세요' }) }));
    process.exit(0);
  });
} else {
  const promptAt = argv.indexOf('--append-system-prompt-file');
  log({ kind: 'stream', argv, cwd: process.cwd(), env: envLog, systemPrompt: promptAt >= 0 ? (() => { try { return fs.readFileSync(argv[promptAt + 1], 'utf8'); } catch { return null; } })() : undefined });
  // ctl.sessionUuid: a UUID session id (the app reads cache clocks and stats only for real-looking ids). ctl.transcript: also leave Claude Code's own transcript lines
  // under <config dir>/projects/<cwd slug>/<session>.jsonl for each user message: ctl.transcriptAgeSec (how long ago the request started), ctl.ttl (300|3600), ctl.compacted,
  // ctl.tokens (the context size the request read, default 22.6K). A /compact leaves only a compact_boundary line (it is not a recorded request), like the real CLI.
  const sid = ctl().sessionUuid ? crypto.randomUUID() : 'fake-session-' + process.pid;
  const writeTranscript = text => {
    const c = ctl(); if (!c.transcript) return;
    const dir = path.join(process.env.CLAUDE_CONFIG_DIR || path.join(process.env.HOME || process.env.USERPROFILE || os.homedir(), '.claude'), 'projects', process.cwd().replace(/[^a-zA-Z0-9]/g, '-'));
    fs.mkdirSync(dir, { recursive: true });
    const at = Date.now() - (c.transcriptAgeSec ?? 0) * 1000, iso = t => new Date(t).toISOString(), ref = 'req_' + Date.now();
    const lines = text === '/compact' ? [{ type: 'system', subtype: 'compact_boundary', timestamp: iso(Date.now()), compactMetadata: { trigger: 'manual', preTokens: 231097, postTokens: 14613 } }] : [{ type: 'api-request', id: ref, timestamp: iso(at) }, { type: 'assistant', timestamp: iso(at + 800), requestRef: ref, promptCacheRequested: c.ttl === 3600 ? '1h' : '5m', message: { model: 'claude-opus-5-5', usage: { input_tokens: 12, output_tokens: 340, cache_creation_input_tokens: 4200, cache_read_input_tokens: (c.tokens ?? 22612) - 4212, ...(c.ttl === 3600 && { cache_creation: { ephemeral_1h_input_tokens: 4200 } }) }, content: [{ type: 'text', text: 'ok' }] } }];
    if (c.compacted) lines.push({ type: 'system', subtype: 'compact_boundary', timestamp: iso(at + 2000), compactMetadata: { trigger: 'auto', preTokens: 180000, postTokens: 14000 } });
    fs.appendFileSync(path.join(dir, sid + '.jsonl'), lines.map(line => JSON.stringify(line) + '\n').join(''));
  };
  const init = { type: 'system', subtype: 'init', session_id: sid, model: (argv.includes('--model') ? argv[argv.indexOf('--model') + 1] : null) ?? 'Model 1.0', permissionMode: 'default', slash_commands: ['compact', 'context'], tools: ['Bash', 'Agent'] };
  send(init);
  const result = (text = 'ok', extra = {}) => send({ type: 'result', is_error: false, result: text, session_id: sid, total_cost_usd: 0.01, duration_ms: 5, num_turns: 1, usage: { input_tokens: 10, output_tokens: 5, cache_creation_input_tokens: 30, cache_read_input_tokens: 500 }, ...extra });
  const say = (text, id = 'm' + Date.now() + Math.random()) => send({ type: 'assistant', message: { id, content: [{ type: 'text', text }], usage: { input_tokens: 10, output_tokens: 5 } } });
  const asst = (content, parent) => send({ type: 'assistant', ...(parent && { parent_tool_use_id: parent }), message: { id: 'm' + Date.now() + Math.random(), content, usage: { input_tokens: 10, output_tokens: 5 } } });
  const toolResult = (id, content, is_error = false) => send({ type: 'user', message: { role: 'user', content: [{ type: 'tool_result', tool_use_id: id, content, ...(is_error && { is_error: true }) }] } });
  const task = (subtype, id, more = {}) => send({ type: 'system', subtype, session_id: sid, tool_use_id: id, ...more });
  let allow = []; // permissions.allow the host put into the flag settings (apply_flag_settings)
  let asking = false; // a can_use_tool request (approval, question, plan) is waiting for its reply
  let slowRun = null; const heldSteers = new Map(); // `slow` turn in flight (ctl.json {"slowms":N}, default 4 s) and steering lines queued behind it: uuid -> line
  // MCP servers for /mcp: alpha is fine, beta fails until reconnected twice, gamma needs a sign-in (mcp_authenticate answers a fake authUrl; the sign-in finishes 2 s later).
  const mcp = new Map([['alpha', { status: 'connected' }], ['beta', { status: 'failed', error: 'Connection closed', tries: 0 }], ['gamma', { status: 'needs-auth', http: true }]]);
  const mcpOut = ([name, v]) => ({ name, status: v.status, ...(v.error && v.status === 'failed' && { error: v.error }), transport: v.http ? 'http' : 'stdio', scope: 'user', config: v.http ? { type: 'http', url: 'https://example.invalid/mcp' } : { type: 'stdio', command: 'node', args: [name + '.mjs'] },
    ...(v.status === 'connected' && { serverInfo: { name, version: '1.0' }, tools: [{ name: 'list_things', description: 'List the things', annotations: { readOnlyHint: true } }, { name: 'delete_thing', annotations: { destructiveHint: true } }] }) });
  const bgTasks = new Map(); // task_id -> { toolUseId, timer }: `bgtask` jobs still running
  readline.createInterface({ input: process.stdin }).on('line', async line => {
    let m; try { m = JSON.parse(line); } catch { return; }
    if (m.type === 'control_request') {
      const sub = m.request?.subtype; log({ kind: 'control', sub, request: m.request });
      if (sub === 'set_permission_mode') send({ type: 'control_response', response: { subtype: 'success', request_id: m.request_id, response: { permissionMode: m.request.mode } } });
      else if (sub === 'cancel_async_message') send({ type: 'control_response', response: { subtype: 'success', request_id: m.request_id, response: { cancelled: heldSteers.delete(m.request.message_uuid) } } });
      else if (sub === 'interrupt') { send({ type: 'control_response', response: { subtype: 'success', request_id: m.request_id, response: {} } }); if (slowRun) { slowRun.abort(); setTimeout(() => result('', { is_error: true, terminal_reason: 'aborted_streaming' }), 150); } else if (asking) { asking = false; setTimeout(() => result('', { is_error: true, terminal_reason: 'aborted_streaming' }), 150); } } // a turn waiting on an approval/question ends with the interrupt's `result`, like the real CLI
      else if (sub === 'apply_flag_settings') { allow = m.request.settings?.permissions?.allow ?? allow; send({ type: 'control_response', response: { subtype: ctl().flag === 'error' ? 'error' : 'success', request_id: m.request_id, response: {} } }); }
      else if (sub?.startsWith('mcp_')) {
        const v = mcp.get(m.request.serverName), ok = response => send({ type: 'control_response', response: { subtype: 'success', request_id: m.request_id, ...(response && { response }) } });
        if (sub === 'mcp_status') ok({ mcpServers: [...mcp].map(mcpOut) });
        else if (!v) send({ type: 'control_response', response: { subtype: 'error', request_id: m.request_id, error: 'Server not found: ' + m.request.serverName } });
        else if (sub === 'mcp_toggle') { v.status = m.request.enabled ? 'connected' : 'disabled'; ok(); }
        else if (sub === 'mcp_reconnect') { if (v.status === 'failed' && ++v.tries < 2) send({ type: 'control_response', response: { subtype: 'error', request_id: m.request_id, error: 'Connection closed' } }); else { v.status = 'connected'; ok(); } }
        else if (sub === 'mcp_authenticate') { ok({ authUrl: 'https://example.invalid/oauth', requiresUserAction: true }); setTimeout(() => { v.status = 'connected'; }, 2000); }
        else if (sub === 'mcp_clear_auth') { v.status = 'needs-auth'; ok(); }
        else ok();
      }
      else send({ type: 'control_response', response: { subtype: 'success', request_id: m.request_id, response: {} } });
      // stop_task: the CLI reports the stopped task itself, after its control reply
      if (sub === 'stop_task' && bgTasks.has(m.request.task_id)) { const t = bgTasks.get(m.request.task_id); clearTimeout(t.timer); bgTasks.delete(m.request.task_id); task('task_notification', t.toolUseId, { status: 'stopped' }); }
      return;
    }
    if (m.type === 'control_response') {
      const reply = m.response?.response ?? {}; asking = false; log({ kind: 'approval-reply', reply });
      say('reply=' + JSON.stringify(reply)); result('replied'); return;
    }
    if (m.type !== 'user') return;
    const parts = m.message?.content ?? [], text = parts.find?.(p => p.type === 'text')?.text ?? '';
    writeTranscript(text);
    log({ kind: 'user', text, images: parts.filter?.(p => p.type === 'image').length ?? 0, uuid: m.uuid });
    if (m.uuid && slowRun) { heldSteers.set(m.uuid, { parts, text }); return; } // the running turn has not taken a steering line in yet
    if (m.uuid) send({ type: 'user', uuid: m.uuid, isReplay: true, message: { role: 'user', content: parts } });
    const wait = ms => new Promise(r => setTimeout(r, ms));
    if (text === '/compact') {
      send({ type: 'system', subtype: 'status', status: 'compacting', session_id: sid }); send({ type: 'system', subtype: 'status', status: null, compact_result: 'success', session_id: sid }); send(init);
      send({ type: 'system', subtype: 'compact_boundary', session_id: sid, compact_metadata: { trigger: 'manual', pre_tokens: 231097, post_tokens: 14613 } });
      send({ type: 'user', message: { role: 'user', content: '<local-command-stdout>Compacted </local-command-stdout>' }, session_id: sid, isReplay: true, uuid: 'echo' + Date.now() });
      result('', { local_command: 'compact', num_turns: 0 }); return;
    }
    // Phone end-to-end rig (scripts/verify/t-phone-e2e.mjs): `e2e-echo <text>` answers `echo: <text>`; `e2e-stream <n> [tag]` streams n answers one line each (`스트림 [tag ]i/n번째 줄입니다.`), 600 ms apart
    // (a long live answer to scroll with), then ends the turn.
    if (text.includes('e2e-stream')) {
      const [, count, tag] = /e2e-stream\s+(\d+)(?:\s+(\w+))?/.exec(text) ?? [], n = Math.min(Number(count ?? 12), 60);
      for (let i = 1; i <= n; i++) { say(`스트림 ${tag ? tag + ' ' : ''}${i}/${n}번째 줄입니다.`); await wait(600); }
      result(`stream ${n}`); return;
    }
    if (text.includes('e2e-echo')) { say('echo: ' + text); result(); return; }
    // Turn change card and file Rewind (chat-snapshots.js): `fsedit write <path> <text>; delete <path>` changes files in the working folder the way
    // a Bash tool would, after the turn's start snapshot (ctl.json {"fsms":N}, default 1.5 s), and answers with a uuid so Rewind can pick that answer.
    if (text.startsWith('fsedit ')) {
      await wait(ctl().fsms ?? 1500);
      for (const command of text.slice(7).split(';').map(item => item.trim()).filter(Boolean)) {
        const [verb, name = '', ...rest] = command.split(' '), file = path.join(process.cwd(), name);
        if (verb === 'write') { fs.mkdirSync(path.dirname(file), { recursive: true }); fs.writeFileSync(file, rest.join(' ').replace(/\\n/g, '\n') + '\n'); }
        if (verb === 'delete') fs.rmSync(file, { force: true, recursive: true });
      }
      send({ type: 'assistant', uuid: crypto.randomUUID(), message: { id: 'm' + Date.now(), content: [{ type: 'text', text: 'done: ' + text.slice(7) }], usage: { input_tokens: 10, output_tokens: 5 } } });
      result(); return;
    }
    // File chips: the [[file:…]] form the system prompt asks for (relative path, :line, folder with a trailing slash), a path link, and look-alikes that must stay plain text.
    // Feedback checks: a ```ui form (the next-step choice), plan-limit reports whose rounded share keeps moving, and a reply with unbreakable tokens. ctl.json {"slowms":N} makes a `slow` turn last.
    if (text.includes('uiformslow')) { say('느린 선택지입니다.' + '\n\n' + '```ui' + '\n' + JSON.stringify(['form', '다음 단계', '선택 보내기', ['radio', 'plan', '방향', 'slow 느리게 처리', '메뉴로 이동']]) + '\n' + '```'); result(); return; } // the chosen answer contains `slow`: a turn that lasts (ctl.json slowms)
    if (text.includes('uiform')) { say('다음 단계를 골라 주세요.\n\n```ui\n' + JSON.stringify(['form', '다음 단계', '선택 보내기', ['radio', 'plan', '방향', '둘 다 제거(권장)', '메뉴로 이동']]) + '\n```'); result(); return; }
    if (text.includes('limitwarn')) { for (const utilization of [0.91, 0.91, 0.96]) send({ type: 'rate_limit_event', rate_limit_info: { status: 'allowed_warning', rateLimitType: 'five_hour', utilization, surpassedThreshold: 0.9, resetsAt: Math.floor(Date.now() / 1000) + 5400 } }); say('한도를 알렸어요.'); result(); return; }
    // Table cell merging: a blank first-column cell and a `^^` cell join the cell above (the last case keeps a blank cell in a middle column as it is).
    if (text.includes('tablemerge')) { say(['| 영역 | 항목 | 비고 |', '| --- | --- | --- |', '| 화면 | 상태바 | 접기 |', '| | 둘러보기 | 용어 통일 |', '| | 안내 카드 | ^^ |', '| 서버 | 업데이트 | |', '| | 피드백 | 상태 배지 |'].join('\n')); result(); return; }
    if (text.includes('longtoken')) { say(['- 최근 3주 안에 갱신된 원격 브랜치 1,677개를 시험 병합해 비교했고, 컬렉션 때문에 새로 생기는 충돌은 위 4개 브랜치뿐입니다. #18344922-' + 'a'.repeat(120) + ' 충돌이 없습니다.', '- 짧은 항목', '', '문단 https://example.com/' + 'path/'.repeat(30) + 'end'].join('\n')); result(); return; }
    if (text.includes('filechips')) { say(['고친 곳은 [[file:src/b.ts:2]] 와 [[file:README.md]] 이고, 폴더 [[file:src/]] 도 봤어요.', '', '- 링크 형태: [a.txt](a.txt)', '- 주소는 그대로: [문서](https://example.com/docs) 와 [[1, 2]]', '', '`[[file:code.ts]]`는 코드라 칩이 아니에요.'].join('\n')); result('chips'); return; }
    if (/\btables\b/.test(text)) { // markdown table samples: long prose cells, many columns, code/CJK, narrow, alignment
      const long = '이 문장은 일부러 아주 길게 써서 셀 안에서 자동 개행이 되는지 확인하기 위한 것입니다. 표가 좌우로 넓어지면 읽기 힘들기 때문에 컨테이너 폭에 맞춰 줄바꿈되어야 합니다.';
      say(['### 1. 긴 문장 셀', '', '| 항목 | 설명 | 비고 |', '|---|---|---|', `| 개행 | ${long} | 통과 |`, `| 영문 | ${'This is a very long English sentence that should wrap inside the cell instead of stretching the table sideways. '.repeat(2)} | ok |`, '',
        '### 2. 열이 많은 표', '', '| id | name | email | role | team | region | status | created | updated | plan |', '|---|---|---|---|---|---|---|---|---|---|', '| 1 | Alice Kim | alice@example.com | admin | platform | seoul | active | 2026-01-02 | 2026-11-01 | enterprise |', '| 2 | Bob Lee | bob@example.com | member | growth | busan | invited | 2026-02-03 | 2026-10-20 | pro |', '',
        '### 3. 코드·긴 토큰·정렬', '', '| 파일 | 경로 | 크기 |', '|:---|:---|---:|', '| `ChatPane.tsx` | `apps/web/src/components/chat/messages/very/deep/ChatPane.tsx` | 12 KB |', '| URL | https://example.com/' + 'a'.repeat(90) + ' | 3 KB |', '',
        '### 4. 열 많고 문장 긴 표', '', '| 구분 | 현상 | 원인 | 영향 | 조치 | 담당 |', '|---|---|---|---|---|---|', `| A | ${long} | ${long} | ${long} | ${long} | 김 |`, '', '### 5. 좁은 2열', '', '| 키 | 값 |', '|---|---|', '| a | 1 |', '| b | 2 |'].join('\n')); result(); return;
    }
    if (text.includes('slow')) {
      const aborted = await new Promise(resolve => { slowRun = { abort: () => resolve(true) }; setTimeout(() => resolve(false), ctl().slowms ?? 4000); });
      slowRun = null; if (aborted) return; // the interrupt handler ended the turn
      say('slow done'); result('slow done');
      for (const [uuid, held] of heldSteers) { heldSteers.delete(uuid); send({ type: 'user', uuid, isReplay: true, message: { role: 'user', content: held.parts } }); say('steer ok: ' + held.text); result(); }
      return;
    }
    // An MCP tool a subagent asks for: the CLI sent no permission_suggestions with it (as in the field), so "항상 허용" has to come from ADE.
    if (text.includes('mcpreset')) { mcp.set('alpha', { status: 'connected' }); mcp.set('beta', { status: 'failed', error: 'Connection closed', tries: 0 }); mcp.set('gamma', { status: 'needs-auth', http: true }); }
    if (text.includes('mcpperm')) { asking = true; send({ type: 'control_request', request_id: 'mcp-' + Date.now(), request: { subtype: 'can_use_tool', tool_name: 'mcp__mooner_server__server_exec', tool_use_id: 'toolu_mcp', input: { command: 'ls -la /etc/stacks' } } }); return; }
    if (text.includes('bashperm')) { asking = true; send({ type: 'control_request', request_id: 'perm-' + Date.now(), request: { subtype: 'can_use_tool', tool_name: 'Bash', tool_use_id: 'toolu_perm', input: { command: 'npm test', description: '테스트 실행' }, permission_suggestions: [{ type: 'addRules', rules: [{ toolName: 'Bash', ruleContent: 'npm test:*' }], behavior: 'allow', destination: 'session' }] } }); return; }
    if (/\bask\b/.test(text)) { asking = true; send({ type: 'control_request', request_id: 'ask-' + Date.now(), request: { subtype: 'can_use_tool', tool_name: 'AskUserQuestion', tool_use_id: 'toolu_q', input: { questions: [{ question: '고르세요', header: '선택', multiSelect: false, options: [{ label: 'A', description: '첫째' }, { label: 'B', description: '둘째' }] }] } } }); return; }
    if (text.includes('plan')) { say('계획을 세웠습니다.'); asking = true; send({ type: 'control_request', request_id: 'plan-' + Date.now(), request: { subtype: 'can_use_tool', tool_name: 'ExitPlanMode', tool_use_id: 'toolu_plan', input: { plan: '# 계획\n\n요약 한 줄\n\n## 1단계 준비\n- a\n- b\n\n## 2단계 구현\n- c\n\n## 3단계 검증\n- d' } } }); return; }
    if (text.includes('subtools')) { const n = Date.now(); // unique ids, so a second run in the same chat is a second subagent. one subagent whose steps are a thought, 4 tools in a row, a thought, 2 tools: the drawer bundles the run of 4
      asst([{ type: 'tool_use', id: 'toolu_s' + n, name: 'Agent', input: { description: '파일 조사', prompt: '파일을 조사' } }]);
      task('task_started', 'toolu_s' + n, { description: '파일 조사', subagent_type: 'Explore', is_backgrounded: false });
      asst([{ type: 'text', text: '파일을 차례로 읽겠습니다.' }], 'toolu_s' + n);
      for (let i = 1; i <= 4; i++) { asst([{ type: 'tool_use', id: 'toolu_r' + n + i, name: 'Read', input: { file_path: `/tmp/f${i}.txt` } }], 'toolu_s' + n); toolResult('toolu_r' + n + i, 'x'); }
      asst([{ type: 'text', text: '이제 검색합니다.' }], 'toolu_s' + n);
      for (let i = 5; i <= 6; i++) { asst([{ type: 'tool_use', id: 'toolu_r' + n + i, name: 'Read', input: { file_path: `/tmp/f${i}.txt` } }], 'toolu_s' + n); toolResult('toolu_r' + n + i, 'x'); }
      task('task_notification', 'toolu_s' + n, { status: 'completed', handback_report: { text: '조사 끝' }, usage: { total_tokens: 900, tool_uses: 6, duration_ms: 900 } });
      toolResult('toolu_s' + n, '조사 끝'); say('조사가 끝났습니다.'); result('waiting'); return;
    }
    if (text.includes('tasks')) {
      asst([{ type: 'tool_use', id: 'toolu_a1', name: 'Agent', input: { description: '조사 A', prompt: 'A를 조사' } }, { type: 'tool_use', id: 'toolu_a2', name: 'Agent', input: { description: '조사 B', prompt: 'B를 조사' } }]);
      task('task_started', 'toolu_a1', { description: '조사 A', subagent_type: 'general-purpose', is_backgrounded: false });
      task('task_started', 'toolu_a2', { description: '조사 B', subagent_type: 'Explore', is_backgrounded: true });
      await wait(300); task('task_progress', 'toolu_a1', { description: 'Running grep', last_tool_name: 'Grep', usage: { total_tokens: 1200, tool_uses: 2, duration_ms: 800 } });
      await wait(300); task('task_notification', 'toolu_a1', { status: 'completed', handback_report: { text: 'A 결과 보고' }, usage: { total_tokens: 2400, tool_uses: 4, duration_ms: 1500 } });
      toolResult('toolu_a1', 'A 결과 보고'); say('A는 끝났고 B는 백그라운드입니다.'); result('waiting');
      await wait(3500); task('task_notification', 'toolu_a2', { status: 'completed', handback_report: { text: 'B 결과 보고' } });
      return;
    }
    if (text.includes('bgtask')) {
      // A background subagent and a background shell that outlive the turn (ctl.json {"bgms":N}, default 10 min), each with the task_id stop_task names.
      const ms = ctl().bgms ?? 600000, n = Date.now();
      asst([{ type: 'tool_use', id: 'toolu_bg' + n, name: 'Agent', input: { description: '오래 걸리는 조사', prompt: '천천히 조사', run_in_background: true } },
        { type: 'tool_use', id: 'toolu_sh' + n, name: 'Bash', input: { command: 'ping -c 600 127.0.0.1', description: '핑 대기', run_in_background: true } }]);
      for (const [id, kind] of [['toolu_bg' + n, 'agent'], ['toolu_sh' + n, 'shell']]) {
        const taskId = `task-${kind}-${n}`;
        task('task_started', id, { task_id: taskId, description: kind === 'agent' ? '오래 걸리는 조사' : '핑 대기', subagent_type: kind === 'agent' ? 'general-purpose' : '', is_backgrounded: true });
        bgTasks.set(taskId, { toolUseId: id, timer: setTimeout(() => { bgTasks.delete(taskId); task('task_notification', id, { status: 'completed', handback_report: { text: kind + ' 끝' } }); }, ms) });
      }
      toolResult('toolu_bg' + n, 'Async agent launched'); toolResult('toolu_sh' + n, 'Command running in background');
      say('백그라운드 작업 2개를 시작했습니다.'); result('started'); return;
    }
    if (text.includes('manytools')) {
      // 8 Reads one after another (a bundle that overflows while it runs; ctl.json {"mtms":N} spaces them), then a long answer.
      for (let i = 1; i <= 8; i++) { const id = `toolu_mt${i}_${Date.now()}`; asst([{ type: 'tool_use', id, name: 'Read', input: { file_path: `src/file${i}.ts` } }]); await wait(ctl().mtms ?? 400); toolResult(id, `line ${i}\n`.repeat(12)); }
      say('## 결과\n\n' + Array.from({ length: 12 }, (_, i) => `${i + 1}. 긴 설명 문단 ${'가나다라 '.repeat(20)}`).join('\n')); result(); return;
    }
    if (text.includes('uiframeform')) { say('폼입니다.\n\n```ade-ui\n' + '<div class="stack"><div class="card"><span class="label">이름</span><input id="n"><button class="primary" id="b-solo">적용</button></div><div class="row"><button id="b-cancel">취소</button><button class="primary" id="b-main">보내기</button><script>void 0</script></div></div>' + '\n```\n'); result(); return; }
    if (text.includes('adeui')) { say('UI입니다.\n\n```ade-ui\n' + "<div><h3>테스트 UI</h3><button id=\"b-send\" class=\"primary\" onclick=\"ade.send('UI에서 보낸 메시지')\">보내기</button> <button id=\"b-pre\" onclick=\"ade.prefill('UI가 채운 문장')\">입력창에 채우기</button> <button id=\"b-net\" onclick=\"fetch('https://example.com/x').then(()=>r.textContent='NET OK').catch(e=>r.textContent='NET BLOCKED')\">외부 요청</button> <button id=\"b-grow\" onclick=\"more.style.height='200px'\">키우기</button><p id=\"r\">대기</p><div id=\"more\"></div></div>" + '\n```\n'); result(); return; }
    if (/\bmermaid\b/.test(text)) {
      say(['배포 흐름', '',
        '```mermaid', 'flowchart LR', '  subgraph repo [depend-backend 레포]', '    stacks[".github/stacks.yml"]', '    dockerfile["Dockerfile"]', '    ci["CI -> OCI 이미지 + Trivy"]', '  end',
        '  subgraph gharp [Gharp / CI]', '    promo["verified promotion 저장"]', '  end', '  subgraph host [단일 호스트]', '    deployer["gharp-deployer"]', '    stacks_cfg["/opt/stacks/projects/..."]', '    pg["shared-postgres"]', '    caddy["Caddy shared network"]', '  end',
        '  stacks --> ci', '  dockerfile --> ci', '  ci --> promo', '  promo --> deployer', '  deployer --> stacks_cfg', '  deployer --> pg', '  deployer --> caddy', '```', '',
        '요청 처리 순서는 이렇게요.', '', '```mermaid', 'sequenceDiagram', '  participant U as 사용자', '  participant A as ADE', '  participant C as Claude', '  U->>A: 채팅 전송', '  A->>C: stream-json', '  C-->>A: assistant', '  A-->>U: Markdown 렌더', '```'].join('\n'));
      result('mermaid'); return;
    }
    if (text.includes('uiblock')) { say('결과입니다.\n\n```ui\n["stats",["가동률","99%","ok","30일"],["지연","24ms"]]\n```\n\n```ui\n["form","계획","보내기",["slider","seats","좌석",2,1],["radio","c","결제","월","년"]]\n```\n\n```ui\n{깨진 json\n```\n'); result(); return; }
    if (text.includes('autoblock')) { // auto mode refuses two calls (a plain command with an exact rule, a compound one without) and says so only in the error result
      const n = Date.now(), why = 'Permission for this action was denied by the Claude Code auto mode classifier. Reason: [Merge Without Review]. If you have other tasks that do not depend on this action, continue working on those.';
      asst([{ type: 'tool_use', id: 'toolu_ab1_' + n, name: 'Bash', input: { command: 'gh pr merge 13 --merge --delete-branch', description: 'PR 13 머지' } }]); toolResult('toolu_ab1_' + n, why, true);
      asst([{ type: 'tool_use', id: 'toolu_ab2_' + n, name: 'Bash', input: { command: 'git push && echo done' } }]); toolResult('toolu_ab2_' + n, why.replace('Merge Without Review', 'Git Destructive'), true);
      say('머지가 자동 모드에 막혔습니다.'); result(); return;
    }
    if (text.includes('다시 실행해')) { say('retry allow=' + JSON.stringify(allow)); result(); return; }
    if (text.includes('tools')) {
      asst([{ type: 'tool_use', id: 'toolu_m1', name: 'mcp__claude_ai_Claude_Docs__update', input: { title: '문서 제목', container: { kind: 'doc' } } }]);
      toolResult('toolu_m1', '{"ok":true,"url":"https://claude.ai/artifact/abc123-def"}');
      asst([{ type: 'tool_use', id: 'toolu_b1', name: 'Bash', input: { command: 'rm -rf x' } }]);
      toolResult('toolu_b1', 'Permission denied: denied by the Claude Code auto mode classifier. Reason: [destructive command]', true);
      asst([{ type: 'tool_use', id: 'toolu_r1', name: 'Read', input: { file_path: 'a.txt' } }]); toolResult('toolu_r1', 'hello');
      say('도구를 썼습니다.'); result(); return;
    }
    say('ok'); send({ type: 'ai-title', aiTitle: 'AI가 붙인 제목' }); result();
  });
}
