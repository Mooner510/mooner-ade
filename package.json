{
  "name": "mooner-ade",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "start": "node apps/local-server/src/index.js",
    "desktop": "pnpm web:build && pnpm --filter @mooner/ade-desktop start",
    "web:build": "pnpm --filter @mooner/ade-web build",
    "typecheck": "tsc --project tsconfig.contract.json && pnpm --filter @mooner/ade-web typecheck",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/verify.mjs",
    "check": "node scripts/verify.mjs && tsc --project tsconfig.contract.json && node --test tests/*.test.mjs",
    "smoke": "node apps/smoke/index.mjs",
    "test:live": "node scripts/live-agent-check.mjs",
    "desktop:dev": "pnpm --filter @mooner/ade-desktop dev"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
