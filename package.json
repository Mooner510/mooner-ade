{
  "name": "mooner-ade",
  "license": "GPL-3.0-only",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "start": "pnpm --filter @mooner/ade-web build && pnpm --filter @mooner/ade-desktop start",
    "dev": "pnpm --filter @mooner/ade-desktop dev",
    "package": "pnpm --filter @mooner/ade-web build && pnpm --filter @mooner/ade-desktop package",
    "release": "node scripts/release.mjs",
    "typecheck": "pnpm --filter @mooner/ade-web typecheck",
    "test": "node --test tests/*.test.mjs",
    "check": "pnpm typecheck && node --test tests/*.test.mjs",
    "e2e": "pnpm --filter @mooner/ade-web build && node scripts/e2e.mjs"
  }
}
